# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Security Whitelist (Comma-separated Telegram User IDs, e.g., 12345678,98765432)
ALLOWED_USER_IDS=your_telegram_user_id_here

# Megaup API Configuration
MEGAUP_UPLOAD_URL=https://megaup.net/api/v2/file/upload
MEGAUP_API_KEY=your_megaup_api_key
MEGAUP_API_KEY2=your_megaup_api_key2
MEGAUP_FOLDER_ID=your_megaup_folder_id

# Storage & Size Limits
TEMP_DOWNLOAD_DIR=/downloads
MAX_FILE_BYTES=5368709120
